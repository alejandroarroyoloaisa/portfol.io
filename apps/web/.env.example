# URL de la API vista desde el servidor de Next (SSR, server actions y proxy).
API_URL=http://localhost:3000/api/v1
# URL de la API vista desde el navegador (registro de visitas al perfil).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# URL pública de esta web: base de las URL canónicas, Open Graph y sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Cookies de sesión con atributo Secure (por defecto: solo en producción).
# COOKIE_SECURE=false
