{
  "name": "@portfolio/api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST + WebSocket de Portfol.io (NestJS, Prisma, PostgreSQL/PostGIS)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "seed": "node -r ts-node/register/transpile-only prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && pnpm seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/serve-static": "^5.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.0",
    "@portfolio/schemas": "workspace:*",
    "@prisma/client": "6.19.3",
    "argon2": "^0.44.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.0",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.0",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.1.0",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.5",
    "@swc/core": "^1.13.0",
    "vitest": "^5.1.1"
  }
}
