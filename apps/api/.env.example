DATABASE_URL="postgresql://portfolio:portfolio@localhost:5434/portfolio?schema=public"
PORT=3000
# Cambia estos secretos en producción
JWT_SECRET="dev-access-secret-cambiar"
JWT_REFRESH_SECRET="dev-refresh-secret-cambiar"
# URL pública con la que se sirven las imágenes (la ve el móvil: usa la IP de tu equipo en la red local)
PUBLIC_URL="http://localhost:3000"
# Orígenes permitidos (CORS), separados por comas
CORS_ORIGINS="http://localhost:3001,http://localhost:8081"
# URL de la web para enlaces públicos del portfolio
WEB_URL="http://localhost:3001"
UPLOAD_DIR="./uploads"
